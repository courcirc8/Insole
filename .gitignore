# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
dist/
build/
*.egg

# Virtual environment
.venv/
venv/
env/

# IDE
.vscode/
.idea/
*.code-workspace
.cursor/

# OS
.DS_Store
Thumbs.db

# Outputs (generated data — too large for git)
outputs/

# Scan data (large binary files — use Git LFS or share separately)
scans/
*.ply
*.stl
*.obj
*.mtl
*.pcd
*.xyz
*.xyzn
*.xyzrgb
*.pts
*.off
*.gltf
*.glb
*.fbx
*.dae

# Archives (scan bundles have been committed by accident before)
*.zip
*.tar
*.tar.gz
*.tgz
*.7z
*.rar

# Documents — personal paperwork must never land in this repo.
# Project docs are re-allowed explicitly below.
*.pdf

# Generated heightmaps / previews
*.npy

# Exceptions
!config_example.yaml
!presets/*.yaml
